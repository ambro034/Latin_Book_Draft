# Jekyll build artifacts
_site/
.sass-cache/
.jekyll-cache/
.jekyll-metadata

# Posts generator directory (contains sensitive config files)
posts-generator/*
# ...but track source code, package, tests, and shared metadata.
# Configs / logs / produced posts / virtualenv remain ignored via the
# wildcard above.
!posts-generator/AGENTS.md
!posts-generator/rag/
!posts-generator/tests/
!posts-generator/requirements-rag.txt
!posts-generator/requirements.txt
!posts-generator/pytest.ini
!posts-generator/openai_worker_4o.py
!posts-generator/scrape_telegram.py
!posts-generator/llm_openrouter.py
!posts-generator/telegram_drafter.py
!posts-generator/substack_drafter.py
!posts-generator/requirements-substack.txt
!posts-generator/.env.example
!posts-generator/style_corpus/

# Configuration files with sensitive data
configs/
# Service account keys (extra protection)
configs/service-account.json

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
env.bak/
venv.bak/

# macOS
.DS_Store
.AppleDouble
.LSOverride
.DS_Store

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Logs
*.log

.specstory/
.cursorindexingignore

# Site audit artifacts
tests/site-audit/node_modules/
tests/site-audit/reports/
tests/site-audit/lychee-*.txt