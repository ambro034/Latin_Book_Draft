# Local-only secrets for substack_drafter.py (and other posts-generator tools).
# Copy to `.env` in this same folder and fill in real values. `.env` is gitignored.
# GitHub secrets cannot be read back, so paste the same values you set there.

# Neon Postgres DSN (enables blog-RAG grounding). Same value as the NEON_DATABASE_URL secret.
NEON_DATABASE_URL=postgres://USER:PASSWORD@HOST/DB?sslmode=require

# OpenRouter (LLM that rewrites the post shorter). Same as OPENROUTER_API_KEY secret.
OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=openai/gpt-4o   # optional override

# Substack auth: the substack.sid cookie value from a logged-in browser session.
# Same as the SUBSTACK_COOKIES_STRING secret.
# NOTE: passwordless Substack accounts (email magic-link / 6-digit code) have NO
# password, so the cookie is the ONLY option here. Grab it from DevTools ->
# Application -> Cookies -> https://substack.com -> "substack.sid".
SUBSTACK_COOKIES_STRING=substack.sid=s%3A...
# SUBSTACK_EMAIL=        # only for password accounts; leave blank if passwordless
# SUBSTACK_PASSWORD=     # only for password accounts; leave blank if passwordless

# Optional; defaults to https://beops.substack.com
SUBSTACK_PUBLICATION_URL=https://beops.substack.com
